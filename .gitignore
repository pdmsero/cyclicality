.env

# Pipeline-regenerable SQLite (do not store remote; rebuild from DVC-tracked inputs)
data/cyclicality.db
data/cyclicality.db-shm
data/cyclicality.db-wal

# litpipe runtime
literature/literature.db-shm
literature/literature.db-wal
literature/literature.db.bak
literature/cache/
literature/sources/
literature/wiki/

# LaTeX build
!paper/build/
paper/build/*
!paper/build/main.pdf
paper/main.pdf
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/*.toc

# Claude Code orphan worktrees
.claude/worktrees/


# Canonical paper output lives in paper/build/ — ignore stray root-level builds
/paper/main.pdf
/paper/main.aux
/paper/main.log
/paper/main.out
/paper/main.bbl
/paper/main.blg
/paper/main.spl
/paper/main.fls
/paper/main.fdb_latexmk
/paper/main.toc

# Python
__pycache__/
*.py[cod]
